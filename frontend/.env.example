# Copy to .env.local and adjust.

# true  = frontend-only demo: all API calls are answered in the browser from dummy data (lib/demo), no backend needed.
# false = normal mode: /api/v1/* is proxied to the FastAPI backend at BACKEND_URL.
# Read at build time — rebuild after changing it.
NEXT_PUBLIC_DEMO_MODE=false

# Backend address for the proxy (ignored in demo mode).
BACKEND_URL=http://127.0.0.1:8000
